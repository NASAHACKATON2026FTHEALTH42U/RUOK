{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "VITE_USE_MOCKS": "true",
      "VITE_SHOWCASE": "true"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
