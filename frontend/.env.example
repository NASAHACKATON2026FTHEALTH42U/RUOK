# Copia a .env.local si necesitas cambiar algo (no se commitea).
# Destino del proxy /api en `npm run dev`. Por defecto: http://localhost:8000
# VITE_API_PROXY_TARGET=http://192.168.8.10:8000
# Origen de la API si no se usa el proxy (vacío = mismo origen)
# VITE_API_ORIGIN=
# Modo demo sin servidor: todo el front contra la API simulada (o ?mocks=1 en la URL)
# VITE_USE_MOCKS=true
# Plan B: si el servidor no responde, las LECTURAS usan datos de ejemplo (banner visible)
# VITE_MOCK_FALLBACK=true
# Escaparate público (demo de Vercel): modo mock sin el banner de datos de ejemplo y con los
# usuarios demo del login plegados en un botón. Solo tiene efecto junto con VITE_USE_MOCKS.
# VITE_SHOWCASE=true
